import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression

print("✓ 所有库已成功安装！")
print(f"NumPy版本: {np.__version__}")
print(f"pandas版本: {pd.__version__}")

# 创建简单的测试数据
np.random.seed(42)
X = np.random.rand(100, 1) * 10
y = 2 * X.squeeze() + 1 + np.random.randn(100) * 2

# 使用线性回归
model = LinearRegression()
model.fit(X, y)
print(f"✓ 线性回归测试: y = {model.coef_[0]:.2f}x + {model.intercept_:.2f}")

# 创建简单图表
plt.figure(figsize=(8, 6))
plt.scatter(X, y, alpha=0.7, label='数据点')
plt.plot(X, model.predict(X), color='red', linewidth=2, label='回归线')
plt.xlabel('X')
plt.ylabel('y')
plt.title('科学计算库测试 - 线性回归')
plt.legend()
plt.grid(True, alpha=0.3)
#plt.savefig('test_plot.png')
plt.show()

print("✓ 图表已生成并保存为 'test_plot.png'")
print("✓ 所有测试通过！")